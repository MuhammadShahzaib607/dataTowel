# ─── DataTowel Backend Environment Variables ───────────────
# Copy this file to .env and fill in your values.
# In production, set these as environment variables in the Vercel dashboard.

# MongoDB Connection
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Server Configuration
PORT=5000

# Frontend URL (comma-separated for multiple origins)
# e.g. "http://localhost:3000,https://your-frontend.vercel.app"
CLIENT_URL=http://localhost:3000

# Cloudinary (image/file storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Firebase Admin SDK (Google authentication)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY=your_firebase_private_key

# Email Service (Gmail)
EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_app_password
